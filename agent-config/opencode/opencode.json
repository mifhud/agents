    "lsp": {
        "gopls": {
            "command": [
                "gopls"
            ],
            "extensions": [
                ".go"
            ],
            "disabled": false
        },
        "jdtls": {
            "disabled": false,
            "command": [
                "jdtls"
            ],
            "extensions": [
                ".java"
            ]
        }
    },
