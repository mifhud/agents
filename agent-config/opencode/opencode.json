{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "edit": "ask",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "bash": {
            "ls": "allow",
            "pwd": "allow",
            "git status": "allow",
            "git diff*": "allow",
            "git add*": "allow",
            "git log*": "allow"
        }
    },
    "default_agent": "build",
    "agent": {
        "plan": {
            "mode": "primary",
            "prompt": "{file:/root/.config/opencode/agents/myplan.txt}",
            "tools": {
                "write": false,
                "edit": false,
                "bash": true
            }
        },
        "build": {
            "mode": "primary",
            "tools": {
                "write": true,
                "edit": true,
                "bash": true
            },
            "permission": {
                "edit": "allow"
            }
        }
    },
    "plugin": [
        "@mohak34/opencode-notifier@latest"
    ],
    "mcp": {
        "web-search-chrome": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "chrome-devtools-mcp@latest",
                "--slim",
                "--headless"
            ]
        },
        "chrome-devtools": {
            "type": "local",
            "command": [
                "npx",
                "chrome-devtools-mcp@latest",
                "--browser-url=http://172.26.112.1:9222"
            ],
            "enabled": true
        },
        "chrome-devtools": {
            "type": "local",
            "command": [
                "node",
                "/usr/lib/tool-dev/chrome-devtools-mcp/build/src/index.js",
                "--browser-url=http://172.26.112.1:9222"
            ],
            "enabled": true
        },
        "activemq": {
            "type": "local",
            "command": [
                "node",
                "/root/01-projects/me/activemq-mcp/dist/index.js"
            ],
            "environment": {
                "ACTIVEMQ_HOST": "localhost",
                "ACTIVEMQ_PORT": "61613",
                "ACTIVEMQ_USERNAME": "admin",
                "ACTIVEMQ_PASSWORD": "admin"
            },
            "enabled": true
        },
        "firecrawl": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "firecrawl-mcp"
            ],
            "environment": {
                "FIRECRAWL_API_KEY": "fc-425c51abc5a7426c8e95201aa3301cc5"
            },
            "enabled": true
        },
        "code-mode": {
            "type": "local",
            "command": [
                "npx",
                "@utcp/code-mode-mcp"
            ],
            "environment": {
                "UTCP_CONFIG_FILE": "${PWD}/.utcp_config.json"
            }
        },
        "mgrep": {
            "type": "local",
            "command": [
                "mgrep",
                "mcp"
            ],
            "enabled": true
        },
        "grep_app": {
            "type": "remote",
            "url": "https://mcp.grep.app",
            "enabled": true
        },
        "exa": {
            "type": "local",
            "command": [
                "node",
                "/root/.nvm/versions/node/v20.19.5/lib/node_modules/exa-mcp-server/.smithery/index.cjs",
                "tools=get_code_context_exa,web_search_exa"
            ],
            "environment": {
                "EXA_API_KEY": "9497cf7e-d3bb-4020-a5f1-e1be00c16679"
            },
            "enabled": true
        },
        "mermaid": {
            "url": "https://mcp.mermaidchart.com/mcp",
            "type": "remote",
            "enabled": true
