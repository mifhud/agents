            "glob": "allow",
            "grep": "allow",
            "list": "allow",
            "read": "allow",
            "write": "ask",
            "todowrite": "allow",
            "todoread": "allow",
            "task": "allow",
            "context7_resolve_library_id": "allow",
            "context7_get_library_docs": "allow",
            "mysql-sit-broadcast_execute_sql": "ask",
            "mysql-sit-apps-config_execute_sql": "ask"
        },
